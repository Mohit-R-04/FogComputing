;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;&lt;div style=&quot;font-size:8.6px;color:#52606d;text-align:center;line-height:1.25;&quot;&gt;temperature&lt;br&gt;+ trend&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#d9e2ec;strokeWidth=1;align=center;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="413" y="830" width="108" height="38" as="geometry"/></mxCell><mxCell id="c56" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;&lt;div style=&quot;font-size:9.2px;font-weight:600;color:#1f2933;text-align:center;line-height:1.25;&quot;&gt;Thermal&lt;br&gt;stress&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eaf7f2;strokeColor=#0f8a6a;strokeWidth=1;align=center;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="419" y="886" width="96" height="40" as="geometry"/></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#7b8794;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#1f2933;text-align:center;&quot;&gt;node_failure&lt;/div&gt;&lt;div style=&quot;font-size:8.4px;color:#52606d;text-align:center;&quot;&gt;P(fail within 2 epochs | e)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f8a6a;strokeWidth=1.6;align=center;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="944" width="192" height="42" as="geometry"/></mxCell><mxCell id="c59" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;&lt;div style=&quot;font-size:9px;font-weight:600;color:#1f2933;text-align:center;&quot;&gt;reliability prior&lt;/div&gt;&lt;div style=&quot;font-size:8.2px;color:#52606d;text-align:center;&quot;&gt;device class&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#d9e2ec;strokeWidth=1;align=center;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="408" y="944" width="110" height="42" as="geometry"/></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#7b8794;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c47" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#7b8794;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#7b8794;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#7b8794;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#7b8794;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c59" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="device class conditions every channel and latent condition; silent channels are summed out" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=8.6;fontColor=#7b8794;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="62" y="992" width="460" height="16" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b style=&quot;color:#1f2933;&quot;&gt;Effect of each improvement&lt;/b&gt; (PR-AUC, cross-validated on training scenarios): paper graph with tertile bins 0.041; supervised bins 0.434; trend evidence 0.562; learned ranked nodes with 8 bins 0.653; bins per device class 0.759." style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=9.3;fontColor=#52606d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="1022" width="480" height="48" as="geometry"/></mxCell><mxCell id="c67" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f8fafc;strokeColor=#cbd2d9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="580" y="470" width="760" height="604" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=0;html=1;fillColor=#1f6fd1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="581" y="471" width="758" height="4" as="geometry"/></mxCell><mxCell id="c69" value="&lt;span style=&quot;color:#1f6fd1;font-weight:700;&quot;&gt;C&lt;/span&gt;&lt;span style=&quot;color:#1f2933;font-weight:700;&quot;&gt;&amp;nbsp;&amp;nbsp;Proactive fault-tolerance controller&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=12.5;fontColor=#52606d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="594" y="482" width="732" height="22" as="geometry"/></mxCell><mxCell id="c70" value="runs inside iFogSim, once per decision epoch" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=9.5;fontColor=#7b8794;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="990" y="484" width="330" height="16" as="geometry"/></mxCell><mxCell id="c71" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f6fd1;margin-bottom:3px;&quot;&gt;N1   BBN inference engine&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;reads every fog node&#x27;s latest report; computes P(fail within the horizon | evidence) exactly, with channels that did not report summed out; names the latent condition driving the risk&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;BbnEngine (Java), identical to the Python engine to 1e-9&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef4fd;strokeColor=#1f6fd1;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="512" width="720" height="76" as="geometry"/></mxCell><mxCell id="c72" value="1" style="ellipse;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1306" y="504" width="18" height="18" as="geometry"/></mxCell><mxCell id="c73" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f6fd1;margin-bottom:3px;&quot;&gt;N2   Risk-aware placement&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;U(m,n) = a(1 - L) + b(1 - E) + g(1 - P)&lt;br&gt;latency against the deadline, radio energy, failure risk; weights per criticality&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;chooseServingNode()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef4fd;strokeColor=#1f6fd1;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="622" width="230" height="116" as="geometry"/></mxCell><mxCell id="c74" value="2" style="ellipse;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="816" y="614" width="18" height="18" as="geometry"/></mxCell><mxCell id="c75" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f6fd1;margin-bottom:3px;&quot;&gt;N2   Expected-loss migration&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;migrate when P x C_fail(m) &amp;gt; C_mig(m, n -&amp;gt; n&#x27;)&lt;br&gt;threshold derived per session: P* = C_mig / C_fail; live migration&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;proactiveStep()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef4fd;strokeColor=#1f6fd1;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="622" width="230" height="116" as="geometry"/></mxCell><mxCell id="c76" value="3" style="ellipse;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1066" y="614" width="18" height="18" as="geometry"/></mxCell><mxCell id="c77" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f6fd1;margin-bottom:3px;&quot;&gt;N3   Selective replication&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;R = P x kappa; the tier minimising overhead plus expected loss: warm standby, checkpoint or none; standbys within budget B&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;replicationStep()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef4fd;strokeColor=#1f6fd1;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="622" width="220" height="116" as="geometry"/></mxCell><mxCell id="c78" value="4" style="ellipse;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1306" y="614" width="18" height="18" as="geometry"/></mxCell><mxCell id="c79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.1597;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c71" target="c73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5069;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c71" target="c75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.8472;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c71" target="c77"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c82" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Actuate on the fog and edge tiers, and recover&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;re-associate users (a genuine iFogSim topology change), switch migrated sessions over, hold standbys; failures are detected by heartbeat timeout and each session recovers as its tier allows: warm standby 35 ms, checkpoint restore about 70 ms, cold restart 330 ms&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;Topology.reassociate(), onDetect(), recover()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="772" width="720" height="72" as="geometry"/></mxCell><mxCell id="c83" value="5" style="ellipse;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1306" y="764" width="18" height="18" as="geometry"/></mxCell><mxCell id="c84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1597;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c73" target="c82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5069;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c75" target="c82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8472;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c77" target="c82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c87" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#0f8a6a;margin-bottom:3px;&quot;&gt;Online CPT learning&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;once a report&#x27;s horizon has passed, its outcome becomes expected counts (the training E-step); the failure table is re-estimated every 5 epochs as a Dirichlet posterior around the offline one&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;BbnPredictor, BbnEngine.refresh()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eaf7f2;strokeColor=#0f8a6a;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="880" width="420" height="88" as="geometry"/></mxCell><mxCell id="c88" value="6" style="ellipse;html=1;fillColor=#0f8a6a;strokeColor=none;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1006" y="872" width="18" height="18" as="geometry"/></mxCell><mxCell id="c89" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Cost model&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;detection 30 ms; state 50-300 KB at 12.5 KB per ms; stop-and-copy 10%; standby budget 20% of sessions; C_mig scaled 0.25-4x for sensitivity&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;FtCostModel&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="880" width="270" height="88" as="geometry"/></mxCell><mxCell id="c90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#0f8a6a;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;dashed=1;dashPattern=5 4;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.343;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c82" target="c87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c91" value="matured outcomes" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=8.8;fontColor=#0f8a6a;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="752" y="851" width="160" height="14" as="geometry"/></mxCell><mxCell id="c92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#0f8a6a;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;dashed=1;dashPattern=5 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="c87" target="c71"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="591" y="920"/><mxPoint x="591" y="574"/></Array></mxGeometry></mxCell><mxCell id="c93" value="refined tables" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=8.8;fontColor=#0f8a6a;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="605" y="594" width="100" height="14" as="geometry"/></mxCell><mxCell id="c94" value="&lt;b style=&quot;color:#1f2933;&quot;&gt;One controller, every policy.&lt;/b&gt; No fault tolerance, cloud-only placement, reactive checkpointing (Rajab and Younis 2021), threshold migration (FTAPA, Gupta and Singh 2025), the same controller driven by ML, and an oracle predictor that knows the hidden health (the upper bound) all run through this class with a different predictor or switches; all policies see identical failure luck (common random numbers keyed on node names), so differences in D come from the decisions alone." style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=9.3;fontColor=#52606d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="600" y="980" width="720" height="90" as="geometry"/></mxCell><mxCell id="c95" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f8fafc;strokeColor=#cbd2d9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1370" y="470" width="420" height="604" as="geometry"/></mxCell><mxCell id="c96" value="" style="rounded=0;html=1;fillColor=#c2551c;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1371" y="471" width="418" height="4" as="geometry"/></mxCell><mxCell id="c97" value="&lt;span style=&quot;color:#c2551c;font-weight:700;&quot;&gt;D&lt;/span&gt;&lt;span style=&quot;color:#1f2933;font-weight:700;&quot;&gt;&amp;nbsp;&amp;nbsp;Evaluation and outputs&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=12.5;fontColor=#52606d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1384" y="482" width="392" height="22" as="geometry"/></mxCell><mxCell id="c98" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#c2551c;margin-bottom:3px;&quot;&gt;Failure-prediction comparison&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;held-out runs only; every choice made on training folds&lt;br&gt;&lt;br&gt;BBN (proposed), BBN with elicited tables only, Naive Bayes, logistic regression, random forest, gradient boosting, neural network (MLP), FTAPA health-index threshold, CPU threshold, BBN + RF fusion (ablation)&lt;br&gt;&lt;br&gt;PR-AUC and ROC-AUC with bootstrap intervals over nodes; Brier, ECE; F1; lead time; robustness as channels go missing; data efficiency; inference cost&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;comparison/run_comparison.py, verify.py&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2551c;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1390" y="512" width="380" height="196" as="geometry"/></mxCell><mxCell id="c99" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#c2551c;margin-bottom:3px;&quot;&gt;Closed-loop fault-tolerance comparison&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;7 policies, each on the same 25 held-out runs (5 unseen regimes x 5 seeds)&lt;br&gt;&lt;br&gt;downtime from failures and migrations (and from handovers), availability of all and critical users, users hit or evacuated, migrations, warm-standby overhead, loop delay, deadline misses; paired Wilcoxon tests&lt;br&gt;&lt;br&gt;degraded telemetry (30% MNAR), cost-ratio sensitivity, ablation of each novelty&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;run_ft_experiments.py&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2551c;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1390" y="724" width="380" height="196" as="geometry"/></mxCell><mxCell id="c100" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Outputs&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;terminal demonstration: build, live BBN training, the BBN controlling iFogSim live, every policy on one run, verdict&lt;br&gt;reports and figures; one command reproduces everything&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;run_demo.sh, run_all.sh&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1390" y="936" width="380" height="118" as="geometry"/></mxCell><mxCell id="c101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#9aa5b1;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c98" target="c99"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#9aa5b1;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c99" target="c100"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.1534;exitY=1;exitDx=0;exitDy=0;entryX=0.5208;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c104" value="labelled telemetry, 31 runs (CSV)" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="308" y="424" width="260" height="14" as="geometry"/></mxCell><mxCell id="c105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.946;exitY=1;exitDx=0;exitDy=0;entryX=0.458;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c106" value="telemetry from every node, every epoch" style=