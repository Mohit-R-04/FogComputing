<mxfile host="drawio" type="device"><diagram name="Project block diagram" id="blockdiagram"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1130" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;span style=&quot;font-size:20px;font-weight:700;color:#1f2933;&quot;&gt;BBN-driven proactive fault tolerance for fog computing&lt;/span&gt;&lt;span style=&quot;font-size:13px;color:#7b8794;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;system block diagram&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=20;fontColor=#52606d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c12" value="iFogSim devices generate telemetry; a Bayesian Belief Network learns P(node fails within two epochs) from it; a controller inside the simulator turns that probability into placement, migration and replication decisions before the failure." style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=10.5;fontColor=#52606d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1600" height="18" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f8fafc;strokeColor=#cbd2d9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="84" width="1760" height="322" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=0;html=1;fillColor=#1f6fd1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="31" y="85" width="1758" height="4" as="geometry"/></mxCell><mxCell id="c15" value="&lt;span style=&quot;color:#1f6fd1;font-weight:700;&quot;&gt;A&lt;/span&gt;&lt;span style=&quot;color:#1f2933;font-weight:700;&quot;&gt;&amp;nbsp;&amp;nbsp;Simulation environment  -  iFogSim 2 on CloudSim (Java, package org.fog.ft)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=12.5;fontColor=#52606d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="96" width="1732" height="22" as="geometry"/></mxCell><mxCell id="c16" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Melbourne CBD dataset&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;1 cloud datacentre and 118 gateways (fog nodes);&lt;br&gt;five user mobility traces&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;edgeResources-melbCBD.csv, random_usersLocation&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="128" width="300" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Twelve operating regimes&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;fog and edge capacity, load, sensor rate, backhaul&lt;br&gt;latency and power; 7 for training, 5 held out&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;ScenarioSpec, ScenarioSweep&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="300" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Cardiac-monitoring application&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;vitals -&amp;gt; client (user device) -&amp;gt; ecg_analyser (serving&lt;br&gt;node) -&amp;gt; alarm; summaries archived in the cloud;&lt;br&gt;patients 25% critical, 45% standard, 30% best-effort&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;Application, Criticality&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="312" width="300" height="84" as="geometry"/></mxCell><mxCell id="c19" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Cloud tier&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;1 datacentre: archival store and fallback analyser; WAN round trip about 200 ms&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;InstrumentedFogDevice (level 0)&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="128" width="560" height="62" as="geometry"/></mxCell><mxCell id="c20" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Fog tier  -  118 gateways&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;each runs an ecg_analyser and a telemetry agent reporting every epoch: CPU, RAM, queue, uplink latency, jitter, handovers, residual energy, temperature, plus five trends (13 channels); a failed node drops every tuple it receives&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;InstrumentedFogDevice (level 1), TelemetryCollector&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="206" width="560" height="92" as="geometry"/></mxCell><mxCell id="c21" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Edge tier  -  20 to 80 user devices&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;client module filters vitals; alarm actuator; battery drains; users walk the traces and hand over between gateways; loop delay measured for every alarm&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;InstrumentedFogDevice (level 2), InstrumentedActuator, MobilityDriver&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="314" width="560" height="82" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#9aa5b1;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#9aa5b1;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Degradation fault model&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;hidden health h in [0, 1] per node, lower on older hardware&lt;br&gt;wear per epoch = W(class) exp(s x stress) x noise, stress from&lt;br&gt;utilisation, backlog, heat, battery depletion and the link&lt;br&gt;shocks; sudden failures (about 1 in 5, no precursor); flat batteries&lt;br&gt;random draws keyed on (seed, scenario, node, epoch)&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;FaultInjector, FtRandom&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="128" width="360" height="132" as="geometry"/></mxCell><mxCell id="c25" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Fail-slow symptoms, inside the simulator&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;as health falls, work per tuple inflates (higher CPU, longer&lt;br&gt;queues and loop delays), the network interface slows, power&lt;br&gt;draw and heat rise: the precursors emerge from iFogSim&#x27;s own&lt;br&gt;scheduler, links and energy model&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;slowdown(), latencyFactor(), heatRise()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="272" width="360" height="124" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#9aa5b1;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#9aa5b1;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Experimental design&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;31 telemetry runs of 100 epochs, one JVM each&lt;br&gt;training: 7 regimes x 3 seeds&lt;br&gt;held out: 5 unseen regimes x 2 unseen seeds&lt;br&gt;whole runs held out; natural failure prevalence&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;design.py, generate_telemetry.py&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="128" width="350" height="116" as="geometry"/></mxCell><mxCell id="c29" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#1f2933;margin-bottom:3px;&quot;&gt;Ground truth  -  never shown to a model&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#52606d;line-height:1.32;&quot;&gt;label: does the node fail within the next 200 time units&lt;br&gt;(two decision epochs)?&lt;br&gt;kept for analysis only: hidden health, failure cause&lt;br&gt;leak audit: 2.0% of repeated node failures share an epoch&lt;br&gt;(92.1% in the earlier data)&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;build_dataset.py&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="256" width="350" height="140" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#9aa5b1;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#9aa5b1;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#9aa5b1;strokeWidth=1.0;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="rounded=1;arcSize=2;html=1;fillColor=#f8fafc;strokeColor=#cbd2d9;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="520" height="604" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=0;html=1;fillColor=#0f8a6a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="31" y="471" width="518" height="4" as="geometry"/></mxCell><mxCell id="c35" value="&lt;span style=&quot;color:#0f8a6a;font-weight:700;&quot;&gt;B&lt;/span&gt;&lt;span style=&quot;color:#1f2933;font-weight:700;&quot;&gt;&amp;nbsp;&amp;nbsp;Offline learning  -  Python&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvetica;fontSize=12.5;fontColor=#52606d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="482" width="492" height="22" as="geometry"/></mxCell><mxCell id="c36" value="&lt;div style=&quot;font-weight:600;font-size:10.5px;color:#1f2933;margin-bottom:3px;&quot;&gt;1  Telemetry pools&lt;/div&gt;&lt;div style=&quot;font-size:9.2px;color:#52606d;line-height:1.32;&quot;&gt;training 314k snapshots (1,508 failures); held out 161k snapshots (422 failures)&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;telemetry_train_pool.csv, telemetry_test_pool.csv&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="512" width="480" height="58" as="geometry"/></mxCell><mxCell id="c37" value="&lt;div style=&quot;font-weight:600;font-size:10.5px;color:#1f2933;margin-bottom:3px;&quot;&gt;2  Model selection, on training scenarios only&lt;/div&gt;&lt;div style=&quot;font-size:9.2px;color:#52606d;line-height:1.32;&quot;&gt;4 folds by scenario: latent-table form x evidence bins x prior strength x EM iterations; robustness tie-break&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;select_bbn.py&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="582" width="480" height="58" as="geometry"/></mxCell><mxCell id="c38" value="&lt;div style=&quot;font-weight:600;font-size:10.5px;color:#1f2933;margin-bottom:3px;&quot;&gt;3  Supervised discretisation, per device class&lt;/div&gt;&lt;div style=&quot;font-size:9.2px;color:#52606d;line-height:1.32;&quot;&gt;up to 8 ordered bins per channel, placed by exact dynamic programming to be most informative of failure&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;discretise.py&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="652" width="480" height="58" as="geometry"/></mxCell><mxCell id="c39" value="&lt;div style=&quot;font-weight:600;font-size:10.5px;color:#1f2933;margin-bottom:3px;&quot;&gt;4  MAP-EM with learned ranked nodes&lt;/div&gt;&lt;div style=&quot;font-size:9.2px;color:#52606d;line-height:1.32;&quot;&gt;latent stress is never observed, hence EM; latent tables are ranked nodes with learned points; elicited priors&lt;/div&gt;&lt;div style=&quot;font-size:8.5px;color:#7b8794;font-family:Menlo,monospace;margin-top:4px;&quot;&gt;train_bbn.py, ranked_node.py, bbn_fast.py&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="722" width="480" height="58" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#3e4c59;strokeWidth=1.3;fontFamily=Helvetica;fontSize=9;fontColor=#52606d;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="&lt;div style=&quot;font-weight:600;font-size:11px;color:#0f8a6a;margin-bottom:3px;&quot;&gt;Trained BBN  -  19 variables&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f8a6a;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=8;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="800" width="480" height="212" as="geometry"/></mxCell><mxCell id="c44" value="data/bbn_trained.json" style="text;html=1;whiteSpace=wrap;rotation=0;fontFamily=Helvet