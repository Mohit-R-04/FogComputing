y="280.00" width="372.00" height="150.00" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Prediction evaluation&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;BBN against 8 alternatives on 159,813 held-out fog and edge snapshots, scored once; bootstrap intervals over nodes; MCAR / MNAR telemetry loss&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fdf4ec;strokeColor=#c2551c;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="504.00" y="280.00" width="372.00" height="150.00" as="geometry"/></mxCell><mxCell id="c13" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Closed-loop evaluation&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;7 policies &amp;times; 25 held-out runs (5 regimes &amp;times; 5 seeds) inside iFogSim with common random numbers; paired Wilcoxon tests, ablation, cost sensitivity&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fdf4ec;strokeColor=#c2551c;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="988.00" y="280.00" width="372.00" height="150.00" as="geometry"/></mxCell><mxCell id="c14" value="selected configuration" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1296.00" y="245.00"/><mxPoint x="206.00" y="245.00"/></Array></mxGeometry></mxCell><mxCell id="c15" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="exports ML and&lt;br&gt;FTAPA models" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>