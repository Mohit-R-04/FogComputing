<mxfile host="drawio" type="device"><diagram name="Pipeline" id="Pipeline"><mxGraphModel dx="1420" dy="470" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1420" pageHeight="470" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Inputs&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;Melbourne CBD edge resources: 1 cloud, 118 fog gateways; mobility traces; cardiac-monitoring application&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#4a5d73;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20.00" y="40.00" width="248.00" height="150.00" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Simulation&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;iFogSim2 + degradation fault model; 12 operating regimes &amp;times; seeds; 31 runs of 10,000 time units&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#4a5d73;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="308.00" y="40.00" width="248.00" height="150.00" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Raw telemetry&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;one row per device per epoch: 13 channels, device class and the label &lt;i&gt;fails within 200 time units&lt;/i&gt;&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#4a5d73;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="596.00" y="40.00" width="248.00" height="150.00" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Split by regime &lt;u&gt;and&lt;/u&gt; seed&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;train: 7 regimes &amp;times; 3 seeds = 21 runs, 314,323 rows&lt;br&gt;held out: 5 regimes &amp;times; 2 seeds = 10 runs, 160,823 rows&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef8f3;strokeColor=#0f8a6a;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="884.00" y="40.00" width="248.00" height="150.00" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Model selection&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;24 configurations, four scenario folds of the training runs only; CV PR-AUC 0.041 &amp;rarr; 0.759&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef8f3;strokeColor=#0f8a6a;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1172.00" y="40.00" width="248.00" height="150.00" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFam