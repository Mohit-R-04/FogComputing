<mxfile host="drawio" type="device"><diagram name="Control loop" id="Control_loop"><mxGraphModel dx="1340" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1340" pageHeight="640" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;One decision epoch&lt;/b&gt; &amp;nbsp;(every 100 time units, one time unit after all reports are in)" style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#1f2933;align=left;verticalAlign=middle;fontStyle=0;spacing=0;rotation=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40.00" y="18.00" width="900.00" height="30.00" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Telemetry reports&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;every live device reports 13 channels; a channel that did not report stays missing&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#4a5d73;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40.00" y="70.00" width="285.00" height="128.00" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;N1 &amp;nbsp;BBN inference&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;P(fail within 2 epochs | e) for every fog node by Eq. (2), and the condition behind it&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#e3eefc;strokeColor=#1f6fd1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365.00" y="70.00" width="285.00" height="128.00" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Online learning&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;reports whose horizon has passed update the node_failure table (Dirichlet); acted-on nodes are censored&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef8f3;strokeColor=#0f8a6a;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="690.00" y="70.00" width="285.00" height="128.00" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;N2 &amp;nbsp;Expected-loss migration&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;move a session when P(F&lt;sub&gt;n&lt;/sub&gt;) &amp;middot; C&lt;sub&gt;fail&lt;/sub&gt; &amp;gt; C&lt;sub&gt;mig&lt;/sub&gt;, i.e. above its own P* = C&lt;sub&gt;mig&lt;/sub&gt;/C&lt;sub&gt;fail&lt;/sub&gt; &amp;nbsp;(Eq. 5)&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#e3eefc;strokeColor=#1f6fd1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1015.00" y="70.00" width="285.00" height="128.00" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;N3 &amp;nbsp;Selective replication&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;per session, the tier with least overhead + P &amp;middot; &amp;kappa; &amp;middot; outage: none, checkpoint or warm standby (&amp;le; 20%) &amp;nbsp;(Eq. 7)&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#e3eefc;strokeColor=#1f6fd1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1015.00" y="300.00" width="285.00" height="128.00" as="geometry"/></mxCell><mxCell id="c8" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Actuation in iFogSim&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;stop-and-copy migrations; replicas provisioned or released; the simulation continues&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fdf4ec;strokeColor=#c2551c;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="690.00" y="300.00" width="285.00" height="128.00" as="geometry"/></mxCell><mxCell id="c9" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Between epochs: detect and recover&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;heartbeat timeout 30 ms; outage by tier: warm 35 ms, checkpoint &amp;asymp; 60&amp;ndash;80 ms, cold restart 330 ms&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#b83232;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365.00" y="300.00" width="285.00" height="128.00" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="font-weight:700;font-size:15px;color:#1f2933;"&gt;Outcomes recorded&lt;/div&gt;&lt;div style="font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;"&gt;failures, migrations, outages and loop delays; reports wait two epochs for their label&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#4a5d73;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40.00" y="300.00" width="285.00" height="128.00" as="geometry"/></mxCell><mxCell id="c11" value="1" style="shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#4a5d73;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="28.00" y="58.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="c12" value="2" style="shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#1f6fd1;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="353.00" y="58.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="c13" value="3" style="shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#0f8a6a;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="678.00" y="58.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="c14" value="4" style="shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#1f6fd1;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1003.00" y="58.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="c15" value="5" style="shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#1f6fd1;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1003.00" y="288.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="c16" value="6" style="shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#c2551c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="678.00" y="288.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="c17" value="7" style="shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#b83232;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="353.00" y="288.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="c18" value="8" style="shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#4a5d73;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="28.00" y="288.00" width="28.00" height="28.00" as="geometry"/></mxCell><mxCell id="c19" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="sessions" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="next epoch" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#0f8a6a;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;div style=&quot;font-weight:700;font-size:15px;color:#1f2933;&quot;&gt;N2 &amp;nbsp;Risk-aware placement, on demand &amp;nbsp;(Eq. 4)&lt;/div&gt;&lt;div style=&quot;font-size:12.5px;color:#52606d;margin-top:4px;line-height:1.3;&quot;&gt;used whenever a session needs a node: at start-up, after every mobility step, as a migration target and for recovery. &amp;nbsp;U = &amp;alpha;(1&amp;minus;L) + &amp;beta;(1&amp;minus;E) + &amp;gamma;(1&amp;minus;P), weights set by the patient's criticality; a user moves for utility only if U improves by more than 0.10&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef4fd;strokeColor=#1f6fd1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;fontStyle=0;dashed=1;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="365.00" y="495.00" width="935.00" height="92.00" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#1f6fd1;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1325.00" y="166.00"/><mxPoint x="1325.00" y="541.00"/></Array></mxGeometry></mxCell><mxCell id="c29" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#1f6fd1;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>