Width=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;shape=note;size=14;" vertex="1" parent="1"><mxGeometry x="650.00" y="322.00" width="160.00" height="64.00" as="geometry"/></mxCell><mxCell id="c17" value='&lt;div style="font-family:Menlo,monospace;font-size:11.5px;font-weight:700;color:#1f2933;"&gt;results/ft/runs/&lt;/div&gt;&lt;div style="font-size:11.5px;color:#52606d;margin-top:3px;"&gt;450 closed-loop runs&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b8794;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;shape=note;size=14;" vertex="1" parent="1"><mxGeometry x="650.00" y="398.00" width="160.00" height="64.00" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.24666666666666667;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.24666666666666667;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1285.00" y="262.00"/></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630.00" y="262.00"/><mxPoint x="630.00" y="300.00"/></Array></mxGeometry></mxCell><mxCell id="c22" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.48;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.48;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175.00" y="462.00"/><mxPoint x="630.00" y="462.00"/><mxPoint x="630.00" y="430.00"/></Array></mxGeometry></mxCell><mxCell id="c25" value="" style="html=1;rounded=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#4a5d73;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#52606d;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9866666666666667;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value='&lt;b&gt;One model file, two engines.&lt;/b&gt; &amp;nbsp;&lt;span style="font-family:Menlo,monospace;"&gt;bbn_trained.json&lt;/span&gt; drives both the Python evaluation and the Java controller inside iFogSim; their posteriors agree to within 1e-15 (the parity test requires 1e-9), and the Python engine matches pgmpy. &amp;nbsp;&lt;b&gt;One command each:&lt;/b&gt; &lt;span style="font-family:Menlo,monospace;"&gt;bash run_all.sh&lt;/span&gt; regenerates every result (&amp;asymp; 45 min); &lt;span style="font-family:Menlo,monospace;"&gt;bash run_demo.sh&lt;/span&gt; runs the nine-stage demonstration (&amp;asymp; 35 s).' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#4a5d73;strokeWidth=1.4;fontFamily=Helvetica;fontSize=13.5;fontColor=#1f2933;align=left;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20.00" y="505.00" width="1420.00" height="80.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>