<mxfile host="drawio" type="device"><diagram name="Implementation" id="Implementation"><mxGraphModel dx="1460" dy="620" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1460" pageHeight="620" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef4fd;strokeColor=#1f6fd1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20.00" y="20.00" width="600.00" height="460.00" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="color:#1f6fd1;font-size:16px;"&gt;Java &amp;middot; iFogSim 2 on CloudSim&lt;/b&gt;&lt;br&gt;&lt;span style="color:#52606d;font-size:12.5px;"&gt;new package &lt;span style="font-family:Menlo,monospace;"&gt;org.fog.ft&lt;/span&gt; (31 classes); upstream source unmodified&lt;/span&gt;' style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#1f2933;align=left;verticalAlign=top;fontStyle=0;spacing=0;rotation=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40.00" y="30.00" width="560.00" height="46.00" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="font-weight:700;font-size:14px;color:#4a5d73;margin-bottom:4px;"&gt;Simulation&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;MelbCBDFaultToleranceSim&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;ScenarioSweep, ScenarioSpec&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;Topology, MobilityDriver&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;FtExperiment (CLI)&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5d73;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=top;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40.00" y="92.00" width="270.00" height="150.00" as="geometry"/></mxCell><mxCell id="c5" value='&lt;div style="font-weight:700;font-size:14px;color:#4a5d73;margin-bottom:4px;"&gt;Devices and faults&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;InstrumentedFogDevice&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;FaultInjector, FtRandom&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;NodeTelemetry, TelemetryCollector&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;InstrumentedActuator&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5d73;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=top;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330.00" y="92.00" width="270.00" height="150.00" as="geometry"/></mxCell><mxCell id="c6" value='&lt;div style="font-weight:700;font-size:14px;color:#1f6fd1;margin-bottom:4px;"&gt;Controller&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;FaultToleranceController&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;FtPolicy (7 policies)&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;FtCostModel, Criticality&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;ServiceSession, SessionRegistry&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f6fd1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=top;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40.00" y="282.00" width="270.00" height="150.00" as="geometry"/></mxCell><mxCell id="c7" value='&lt;div style="font-weight:700;font-size:14px;color:#1f6fd1;margin-bottom:4px;"&gt;Predictors&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;BbnEngine, BbnPredictor&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;MlPredictor&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;HealthIndexPredictor (FTAPA)&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;OraclePredictor&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f6fd1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=top;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330.00" y="282.00" width="270.00" height="150.00" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef8f3;strokeColor=#0f8a6a;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840.00" y="20.00" width="600.00" height="460.00" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="color:#0f8a6a;font-size:16px;"&gt;Python 3.12 &amp;middot; model/&lt;/b&gt;&lt;br&gt;&lt;span style="color:#52606d;font-size:12.5px;"&gt;NumPy, pandas, SciPy, scikit-learn, Rich; pytest; pgmpy for cross-checks&lt;/span&gt;' style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#1f2933;align=left;verticalAlign=top;fontStyle=0;spacing=0;rotation=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="860.00" y="30.00" width="560.00" height="46.00" as="geometry"/></mxCell><mxCell id="c10" value='&lt;div style="font-weight:700;font-size:14px;color:#0f8a6a;margin-bottom:4px;"&gt;Dataset&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;generate_telemetry&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;javarun (parallel JVMs)&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;build_dataset&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;design (split, seeds)&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f8a6a;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=top;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860.00" y="92.00" width="270.00" height="150.00" as="geometry"/></mxCell><mxCell id="c11" value='&lt;div style="font-weight:700;font-size:14px;color:#0f8a6a;margin-bottom:4px;"&gt;Learning&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;discretise (exact DP)&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;ranked_node, bbn_fast&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;select_bbn&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;train_bbn (MAP-EM)&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f8a6a;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=top;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1150.00" y="92.00" width="270.00" height="150.00" as="geometry"/></mxCell><mxCell id="c12" value='&lt;div style="font-weight:700;font-size:14px;color:#c2551c;margin-bottom:4px;"&gt;Evaluation&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;predict, verify&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;comparison/run_comparison&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;export_models&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;run_ft_experiments&lt;/div&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2551c;strokeWidth=1.4;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=top;fontStyle=0;dashed=0;shadow=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860.00" y="282.00" width="270.00" height="150.00" as="geometry"/></mxCell><mxCell id="c13" value='&lt;div style="font-weight:700;font-size:14px;color:#c2551c;margin-bottom:4px;"&gt;Tests and demo&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;test_inference (29)&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;test_pipeline (18)&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;test_java_parity (3)&lt;/div&gt;&lt;div style="font-family:Menlo,monospace;font-size:12px;color:#1f2933;margin-top:3px;"&gt;crosscheck_pgmpy, demo&lt;/div&gt;' style="rounded=1;arcSize=8;